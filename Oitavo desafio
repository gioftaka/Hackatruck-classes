                Color.brown
                    .ignoresSafeArea()
                
                VStack(alignment: .leading) {
                    Color.clear
                        .frame(maxWidth: .infinity, height: 300)
                    .overlay {AsyncImage(url: URL(string: "https://foodbiz.com.br/wp-content/uploads/2026/01/comidas-picantes.jpg")) { image in
                        image
                            .resizable()
                            .scaledToFill()
                    } placeholder: {
                        ProgressView()
                    }
                    } .clipped()
                    .ignoresSafeArea(edges:.top)


                    ScrollView {
                        ForEach(viewModel.receitas) { i in
