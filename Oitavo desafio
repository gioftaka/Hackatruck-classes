                                ReceitaRow(receita: i)
                            } .buttonStyle(.plain)
                        if i.id != viewModel.receitas.last?.id {
                            Divider()
                                .padding(.leading,104)
                                .padding(.trailing,20)
                    }
                        }
                    }
                } 
                    .frame(maxWidth: .infinity)
                    
                    Button(action: {showingAddRecipe = true}) {
                        Text("Adicionar uma receita")
                            .font(.headline)
                            .foregroundStyle(.white)
                            .frame(maxWidth: .infinity)
                            .padding()
                            .background(Color.orange)
                            .cornerRadius(10)
                    }
                    .padding()
                }
                .frame(maxWidth: .infinity)
            }
    }
        .task {
            await viewModel.fetch()
        }
        .sheet(isPresented: $showingAddRecipe) {
            AddReceitaView { novaReceita in
                Task {
                    await viewModel.adicionar(receita: novaReceita)
