            AsyncImage(url: URL(string: "https://thumbs.dreamstime.com/b/old-recipe-note-background-concept-44800598.jpg")) { image in
                image
                    .resizable()
                    .scaledToFill()
                    .ignoresSafeArea()
                    .blur(radius: 30)
            } placeholder: {
                ProgressView()
            }
            
            VStack(alignment: .leading, spacing: 15) {
                AsyncImage(url: URL(string: receita.imagem)) { image in
                image
                    .resizable()
                    .scaledToFit()
                    .ignoresSafeArea()
                    .frame(width: 200,height: 200)
            } placeholder: {
                ProgressView()
            }
                Text(receita.nome)
                    .font(.largeTitle)
                    .bold()
                    .foregroundStyle(.white)
                
                Text("**Tempo**: \(receita.tempoDePreparo)")
                    .font(.headline)
                    .foregroundStyle(.orange)
                    
                
                Text("**Rendimento**: \(receita.rendimento)")
                    .font(.headline)
                    .foregroundStyle(.orange)
                
                ScrollView {
                    Text(receita.modoDePreparo)
                        .font(.body)
                        .foregroundStyle(.white)
                        .padding()
                        .frame()
                        .lineLimit(nil) 
                        .fixedSize(horizontal: false, vertical: true)
                        .padding(20)
                }
                .background(Color.brown.opacity(0.6))
                .cornerRadius(10)
            }
            .padding()
        }
    }
}


