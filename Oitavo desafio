import SwiftUI

struct ContentView: View {
    @State private var viewModel = ViewModel()
    @State private var showingAddRecipe = false

    var body: some View {
        NavigationStack {
            ZStack {
                Color.brown
                    .ignoresSafeArea()
                
                VStack(alignment: .leading) {
                    
                    AsyncImage(url: URL(string: "https://foodbiz.com.br/wp-content/uploads/2026/01/comidas-picantes.jpg")) { image in
                        image
                            .resizable()
                            .scaledToFill()
                            .frame(maxWidth: .infinity, maxHeight: 300)
                            .clipped()
                            .ignoresSafeArea()
                    } placeholder: {
                        ProgressView()
                    }
                    
                    ScrollView {
                        ForEach(viewModel.receitas) { i in
                            NavigationLink(destination: DetailView(receita: i)) {
                                HStack(spacing: 15) {
                                    AsyncImage(url: URL(string: i.imagem)) { image in
                                        image
                                            .resizable()
                                            .scaledToFit()
                                            .clipShape(Rectangle())
                                            .frame(width: 100, height: 100)
                                            .padding(.leading, 5)
                                    } placeholder: {
                                        ProgressView()
                                            .frame(width: 100, height: 100)
                                    }
                                    
                                    Text(i.nome)
                                        .font(.title2)
                                        .foregroundStyle(.black)
                                        .lineLimit(1)
                                        
                                    Spacer()
                                }
                                .padding(.vertical, 10)
                            }
                        }
                    }
                    .frame(maxWidth: .infinity, maxHeight: 400)
                    
                    Button(action: {showingAddRecipe = true}) {
                        Text("Adicionar uma receita")
                            .font(.headline)
                            .foregroundStyle(.white)
                            .frame(maxWidth: .infinity)
                            .padding()
                            .background(Color.orange)
                            .cornerRadius(10)
                    }
                    .padding()
                }
            }
        }
        .task {
            await viewModel.fetch()
        }
        .sheet(isPresented: $showingAddRecipe) {
            AddReceitaView { novaReceita in
                Task {
                    await viewModel.adicionar(receita: novaReceita)
                }
            }
        }
    }
}

struct AddReceitaView: View {
    @Environment(\.dismiss) private var dismiss
    var onSave: (Receitas) -> Void
    
    @State private var nome = ""
    @State private var tempoDePreparo = ""
    @State private var rendimento = ""
    @State private var modoDePreparo = ""
    @State private var imagem = ""
    
    var body: some View {
        NavigationStack {
            Form {
                Section(header: Text("Informações da Receita")) {
                    TextField("Nome da receita", text: $nome)
                    TextField("Tempo de Preparo (ex: 45 minutos)", text: $tempoDePreparo)
                    TextField("Rendimento (ex: 6 porções)", text: $rendimento)
                    TextField("URL da Imagem", text: $imagem)
                }
                
                Section(header: Text("Modo de Preparo")) {
                    TextEditor(text: $modoDePreparo)
                        .frame(height: 120)
                }
            }
            .navigationTitle("Nova Receita")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancelar") {
                        dismiss()
                    }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Salvar") {
                        let novaReceita = Receitas(
                            nome: nome,
                            tempoDePreparo: tempoDePreparo,
                            rendimento: rendimento,
                            modoDePreparo: modoDePreparo,
                            imagem: imagem
                        )
                        onSave(novaReceita)
                        dismiss()
                    }
                    .disabled(nome.isEmpty || modoDePreparo.isEmpty)
                }
            }
        }
    }
}

struct Service {
    func fetchReceitas(url: String) async throws -> [Receitas] {
        guard let url = URL(string: url) else { return [] }
        let (data, _) = try await URLSession.shared.data(from: url)
        let values = try JSONDecoder().decode([Receitas].self, from: data)
        return values
    }
    func adicionarReceita(url: String, receita: Receitas) async throws {
        guard let url = URL(string: url) else { return }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.httpBody = try JSONEncoder().encode(receita)
        
        let (_, response) = try await URLSession.shared.data(for: request)
        
        guard let httpResponse = response as? HTTPURLResponse, (200...299).contains(httpResponse.statusCode) else {
            throw URLError(.badServerResponse)
        }
    }
}

@Observable
class ViewModel {
    var receitas: [Receitas] = []
    private let service = Service()
    
    func fetch() async {
        let url = "http://127.0.0.1:1880/pegar"
        do {
            receitas = try await service.fetchReceitas(url: url)
        } catch {
            print(error.localizedDescription)
        }
    }
    func adicionar(receita: Receitas) async {
        let url = "http://127.0.0.1:1880/adicionar"
        do {
            try await service.adicionarReceita(url: url, receita: receita)
            await fetch()
        } catch {
            print("Erro ao adicionar:", error.localizedDescription)
        }
    }
}

