struct ContentView: View {

    @State private var inputText = ""

    var body: some View {

        NavigationStack {
            
            VStack {

                TextField("Digite algo", text: $inputText)
                    .textFieldStyle(.roundedBorder)
                    .frame(width: 300)

                HStack{

                    NavigationLink {
                        FirstView(inputText: inputText)
                    } label: {
                        Label("",systemImage: "paintbrush")
                            .labelStyle(.iconOnly)
                            .font(.system(size:60))
                            .frame(width: 100, height:100)
                            .background(.pink)
                            .cornerRadius(20)
                    }
                    .buttonStyle(.plain)
                    .foregroundStyle(.white)

                    NavigationLink {
                        SegundaView(inputText: inputText)

                    } label: {
                        Label("",systemImage: "paintbrush.pointed")
                            .labelStyle(.iconOnly)
                            .font(.system(size:60))
                            .frame(width: 100, height:100)
                            .background(.blue)
                            .cornerRadius(20)
                    }
                    .buttonStyle(.plain)
                    .foregroundColor(.white)
                }

                HStack{
                    NavigationLink {
                        TerceiraView(inputText: inputText)
                    } label: {
                        Label("",systemImage: "paintpalette")
                            .labelStyle(.iconOnly)
                            .font(.system(size:60))
                            .frame(width: 100, height:100)
                            .background(.gray)
                            .cornerRadius(20)
                    }
                    .buttonStyle(.plain)
                    .foregroundColor(.white)

                    NavigationLink {
                        QuartaView(inputText: inputText)
                    } label: {
                        Label("",systemImage: "list.bullet")
                            .labelStyle(.iconOnly)
                            .font(.system(size:60))
                            .frame(width: 100, height:100)
                            .background(.purple)
                            .cornerRadius(20)
                        }
                    .buttonStyle(.plain)
                    .foregroundColor(.white)
                }

            }
        .navigationTitle("Menu de Cores")
        }
    }
}


