import SwiftUI


struct FirstView: View {
    let inputText: String
    var body: some View {

        ZStack{
            Color.pink
            .ignoresSafeArea()
            VStack{
                ZStack {
                    Circle()
                        .fill(.black)
                        .frame(width: 250, height:250)

                    Image(systemName: "paintbrush")
                        .resizable()
                        .scaledToFit()
                        .frame(width:180, height: 180)
                        .foregroundColor(.pink)
                }
            Text(inputText)
            }
        }
    }
}

