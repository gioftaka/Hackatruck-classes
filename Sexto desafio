import SwiftUI

// Adicionado para evitar erro caso a cor não exista no seu Assets
extension Color {
    static let bordo = Color(red: 0.5, green: 0.0, blue: 0.13)
}

struct ContentView: View {
    @State private var viewModel = ViewModel()
    
    var body: some View {
        NavigationStack {
            ZStack {
                Color.bordo
                    .ignoresSafeArea()
                
                VStack(alignment: .leading) {
                    // Header Image
                    AsyncImage(url: URL(string: "https://img.quizur.com/f/img5fad8dbe2b3681.02022717.jpg?lastEdited=1605209536")) { image in
                        image
                            .resizable()
                            .scaledToFill()
                            .frame(maxWidth: .infinity, maxHeight: 300)
                            .clipped()
                            .ignoresSafeArea(edges: .top)
                    } placeholder: {
                        ProgressView()
                            .frame(maxWidth: .infinity, maxHeight: 300)
                    }
                    
                    ScrollView {
                        VStack(spacing: 15) {
                            ForEach(viewModel.personagens) { personagem in
                                NavigationLink(destination: DetailView(personagem: personagem)) {
                                    HStack(spacing: 15) {
                                        // Imagem do Personagem
                                        AsyncImage(url: URL(string: personagem.image ?? "")) { image in
                                            image
                                                .resizable()
                                                .scaledToFill()
                                                .frame(width: 80, height: 80)
                                                .clipShape(Circle())
                                                .padding(.leading, 10)
                                        } placeholder: {
                                            Circle()
                                                .fill(Color.gray.opacity(0.3))
                                                .frame(width: 80, height: 80)
                                                .overlay(ProgressView())
                                                .padding(.leading, 10)
                                        }
                                        
                                        // Nome do Personagem
                                        Text(personagem.name ?? "Desconhecido")
                                            .font(.title2)
                                            .foregroundStyle(.yellow)
                                            .lineLimit(1)
                                        
                                        Spacer()
                                    }
                                    .padding(.vertical, 5)
                                }
                            }
                        }
                    }
                }
            }
        }
        .task {
            await viewModel.fetch()
        }
    }
}

struct Service {
    func fetchPersonagens(url: String) async throws -> [HaPo] {
        guard let url = URL(string: url) else { return [] }
        let (data, _) = try await URLSession.shared.data(from: url)
        return try JSONDecoder().decode([HaPo].self, from: data)
    }
}

@Observable
class ViewModel {
    var personagens: [HaPo] = []
    private let service = Service()
    
    func fetch() async {
        let url = "https://hp-api.onrender.com/api/characters/house/gryffindor"
        do {
            personagens = try await service.fetchPersonagens(url: url)
        } catch {
            print(error.localizedDescription)
        }
    }
}

struct HaPo: Decodable, Identifiable {
    let id: String
    let name: String?
    let alternate_names: [String]?
    let species: String?
    let gender: String?
    let house: String?
    let dateOfBirth: String?
    let yearOfBirth: Int?
    let wizard: Bool?
    let ancestry: String?
    let eyeColour: String?
    let hairColour: String?
    let wand: Wand?
    let patronus: String?
    let hogwartsStudent: Bool?
    let hogwartsStaff: Bool?
    let actor: String?
    let alternate_actors: [String]?
    let alive: Bool?
    let image: String?
}

struct Wand: Codable {
    let wood: String?
    let core: String?
    let length: Double?
}

struct DetailView: View {
    let personagem: HaPo
    
    var body: some View {
        ZStack {
            // Background Image
            AsyncImage(url: URL(string: "https://img.quizur.com/f/img5fad8dbe2b3681.02022717.jpg?lastEdited=1605209536")) { image in
                image
                    .resizable()
                    .scaledToFill()
                    .ignoresSafeArea()
                    .blur(radius: 30)
            } placeholder: {
                Color.bordo.ignoresSafeArea()
            }
            
            VStack {
                // Imagem de Detalhe
                AsyncImage(url: URL(string: personagem.image ?? "")) { image in
                    image
                        .resizable()
                        .scaledToFit()
                        .clipShape(Circle())
                        .frame(width: 250, height: 250)
                        .shadow(radius: 10)
                } placeholder: {
                    Circle()
                        .fill(Color.gray.opacity(0.3))
                        .frame(width: 250, height: 250)
                        .overlay(ProgressView())
                }
                .padding(.top, 40)
                
                // Informações
                VStack(alignment: .leading, spacing: 10) {
                    Text("**House**: \(personagem.house ?? "N/A")")
                    Text("**Name**: \(personagem.name ?? "N/A")")
                    Text("**Birth**: \(personagem.dateOfBirth ?? "N/A")")
                    Text("**Eyes**: \(personagem.eyeColour ?? "N/A")")
                }
                .foregroundStyle(.white)
                .padding()
                .background(Color.bordo.cornerRadius(15))
                .shadow(radius: 5)
                .font(.title2)
                .padding(.top, 20)
                
                Spacer()
            }
        }
    }
}

