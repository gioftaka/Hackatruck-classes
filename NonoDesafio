struct Service {
    func fetchProdutos(url: String) async throws -> [Produtos] {
        guard let url = URL(string: url) else { return [] }
        let (data, _) = try await URLSession.shared.data(from: url)
        return try JSONDecoder().decode([Produtos].self, from: data)
    }
}

