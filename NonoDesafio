import SwiftUI
import Translation

struct ContentView: View {
    @State private var viewModel = ViewModel()
    let ordemTipos = ["ENTRADA", "PRINCIPAL", "SOBREMESA", "BEBIDA"]

    var body: some View {
        ZStack {
            Color.amareloClaro
                .ignoresSafeArea()

            VStack {
                Text("HackaTruck GastroBar")
                    .font(.title).bold()

                ScrollView {
                    LazyVStack(alignment: .leading, spacing: 0) {
                        ForEach(ordemTipos, id: \.self) { tipo in
                            if let itens = viewModel.agrupados[tipo] {
                                Section {
                                    ForEach(itens) { produto in
                                        DetalhesProduto(produto: produto)
                                            .padding(.vertical, 8)
                                            .background(Color.blue)
                                    }
                                } header: {
                                    Text(tipo)
                                        .font(.headline)
                                        .frame(maxWidth: .infinity, alignment: .leading)
                                        .padding(.vertical, 6)
                                        .padding(.horizontal, 20)
                                        .background(Color.amareloClaro)
                                }
                            }
                        }
                    }
                }
            }
        }
        .task { await viewModel.fetch() }
    }
}

struct Produtos: Identifiable, Codable {
    var id: String = UUID().uuidString
    let nome: String
    let imagem: String
    let preco: Double
    let tipo: String

    enum CodingKeys: String, CodingKey {
        case nome, imagem, preco, tipo
    }
}

struct DetalhesProduto: View {
    let produto: Produtos
    @State private var showTranslation = false

    var body: some View {
        HStack(spacing: 12) {
            AsyncImage(url: URL(string: produto.imagem)) { image in
                image
                    .resizable()
                    .scaledToFill()
            } placeholder: {
                Color.gray.opacity(0.3)
            }
            .frame(width: 60, height: 60)
            .clipShape(RoundedRectangle(cornerRadius: 8))

            VStack(alignment: .leading) {
                Text(produto.nome)
                Text("R$ \(produto.preco, specifier: "%.2f")")
                    .font(.subheadline)
            }

            Spacer()

            Button {
                showTranslation = true
            } label: {
                Image(systemName: "translate")
            }
            .buttonStyle(.plain)
        }
        .padding(.horizontal, 8)
        .translationPresentation(isPresented: $showTranslation, text: produto.nome)
    }
}

@Observable
class ViewModel {
    var produtos: [Produtos] = []
    private let service = Service()
    let url = "http://127.0.0.1:1880/pegar"

    // true = dados fixos para teste local; false = busca no Node-RED
    let modoLocal = true

    var agrupados: [String: [Produtos]] {
        Dictionary(grouping: produtos, by: \.tipo)
    }

    func fetch() async {
        if modoLocal {
            produtos = Produtos.mock
            return
        }
        do {
            produtos = try await service.fetchProdutos(url: url)
        } catch {
            print(error.localizedDescription)
        }
    }
}

