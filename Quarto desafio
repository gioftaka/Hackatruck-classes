struct LinhaConteudo: View {
    let conteudo: Conteudo

    var body: some View {
        HStack {
        ZStack {
            RoundedRectangle(cornerRadius: 5)
                .fill(.white)
                .frame(width: 350, height: 50)
                .glowBorder(Color:.black, LineWidth:10)
                
            HStack(spacing: 10) {
                AsyncImage(url: URL(string: conteudo.capa)) { image in
                    image
                        .resizable()
                        .scaledToFill()
                } placeholder: {
                    ProgressView()
                }
                .frame(width: 30, height: 50)
                .clipped()

                VStack(alignment: .leading, spacing: 2) {
                    Text(conteudo.nome)
                        .lineLimit(1)
                        .foregroundStyle(.black)
                    Text(conteudo.ano)
                        .font(.system(size: 12))
                }

                Spacer()

                Text(conteudo.pais)
            }
            .padding(.horizontal, 10)
            .frame(width: 350, height: 50)
        }
        Spacer()
    }
}
}

struct DetalheView: View {
    let conteudo: Conteudo

    var body: some View {
        ZStack {
            LinearGradient(colors: [.gray, .black], startPoint: .top, endPoint: .bottom)
                .ignoresSafeArea()

            VStack(spacing: 16) {
                AsyncImage(url: URL(string: conteudo.capa)) { image in
                    image
                        .resizable()
                        .scaledToFill()
                } placeholder: {
                    ProgressView()
                }
                .frame(width: 260, height: 360)
                .clipShape(RoundedRectangle(cornerRadius: 14))
                .glowBorder(Color:.black, LineWidth:10)

                Text(conteudo.nome)
                    .font(.title2)
                    .foregroundStyle(.white)

                VStack(spacing: 4) {
                    Text("**Categoria**: \(conteudo.categoria)")
                    Text("**Ano**: \(conteudo.ano)")
                    Text("**Gênero**: \(conteudo.genero)")
                    Text("**País**: \(conteudo.pais)")
                }
                .font(.subheadline)
                .foregroundStyle(.yellow)

                Text("**IMBd**: \(conteudo.imdb, specifier: "%.1f")")
                    .font(.headline.system(size: 20))
                    .padding(.horizontal, 24)
                    .padding(.vertical, 12)
                    .background(.black)
                    .foregroundStyle(.yellow)
                    .cornerRadius(12)
                    .glowBorder(Color:.yellow, LineWidth:10)
                    //.shadow(color: .yellow.opacity(0.8), radius: 5, x: 0, y: 0)
                    //.shadow(color: .yellow.opacity(0.4), radius: 15, x: 0, y: 0)
            }
        }
        .navigationBarTitleDisplayMode(.inline)
    }
}

struct Conteudo: Hashable {
    let categoria: String
    let nome: String
    let capa: String
    let ano: String
    let genero: String
    let pais: String
    let imdb: Double
}


