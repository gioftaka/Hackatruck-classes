struct Location: Hashable, Identifiable {
    var id: String{nome}    
    let nome: String
    let foto: String
    let descricao: String
    let latitude: Double
    let longitude: Double
    
}


struct SheetView: View {
    let regiao: Location
    
    var body: some View {

        ZStack {
            Rectangle()
                .fill(Color.buttermilk)
                .ignoresSafeArea()
            
            VStack(spacing: 15) {

                AsyncImage(url: URL(string: regiao.foto)) { image in
                    image
                        .resizable()
                        .scaledToFill()
                        .frame(width: 300, height: 250)
                        .clipShape(RoundedRectangle(cornerRadius: 12))                       

                } placeholder: {
                    ProgressView()
                }
                .padding(.top)
                
                Text(regiao.nome)
                    .font(.title)
                    .foregroundStyle(.brown)
                    .bold()
                    .padding()
                
                ScrollView {

                    Text(regiao.descricao)
                        .bold()
                        .padding(20)
                        .background(
                            Rectangle()
                                .fill(.brown)
                        )
                        .padding(.horizontal, 20)
                }
            }
        }
    }
}



