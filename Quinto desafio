    @State private var localSelecionadoMapa: Location?
    
    var body: some View {
        
        ZStack {
            Map(position: $position, selection: $localSelecionadoMapa) {
                Marker(regiao.nome, coordinate: CLLocationCoordinate2D(latitude: regiao.latitude, longitude: regiao.longitude)).tag(regiao)
            }
            .ignoresSafeArea()

           VStack (alignment: .leading, spacing:10){

                ZStack {
                    Rectangle()
                        .fill(Color.buttermilk)
                       .frame(width:300, height:50)
                        .cornerRadius(10)
                                      
                    Picker("",selection: $regiao) {
                        ForEach(maravilhas, id: \.self) { maravilha in
                            Text(maravilha.nome)
                                .tag(maravilha)                        
                                .padding()
                        }
                    }
                    .onChange(of: regiao) { _, novaRegiao in
                      position = .region(
                            MKCoordinateRegion(
                                center: CLLocationCoordinate2D(latitude: novaRegiao.latitude, longitude: novaRegiao.longitude),
                                span: MKCoordinateSpan(latitudeDelta: 0.5, longitudeDelta: 0.5)
                            )
                        )
                   }
                }
                Spacer()                
         }
            .padding()
        }
        .sheet(item: $localSelecionadoMapa) { local in
            SheetView(regiao: local)
        }
    }
